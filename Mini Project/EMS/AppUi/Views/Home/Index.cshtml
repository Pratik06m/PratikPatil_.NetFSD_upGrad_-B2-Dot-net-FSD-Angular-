@model HomeViewModel
@{
    ViewData["Title"] = "Explore Events";
    Layout = "_ParticipantLayout";
}

<div class="p-5 mb-4 rounded-3 text-white" style="background: linear-gradient(135deg,#6f42c1,#0d6efd);">
    <div class="container-fluid py-3">
        <h1 class="display-5 fw-bold"><i class="fa fa-graduation-cap me-3"></i>upGrad Virtual Events</h1>
        <p class="col-md-8 fs-4">Discover and register for cutting-edge virtual events in Tech, Innovation, and Industry.</p>
    </div>
</div>

<!-- Category Filter -->
<div class="mb-4">
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <span class="fw-semibold me-2">Filter by Category:</span>
        <a href="@Url.Action("Index")" class="btn btn-sm @(Model.SelectedCategory == null ? "btn-primary" : "btn-outline-primary")">All</a>
        @foreach (var cat in Model.Categories)
        {
            <a href="@Url.Action("Index", new { category = cat })"
               class="btn btn-sm @(Model.SelectedCategory == cat ? "btn-primary" : "btn-outline-primary")">
                @cat
            </a>
        }
    </div>
</div>

@if (!Model.Events.Any())
{
    <div class="alert alert-info">
        <i class="fa fa-info-circle me-2"></i>No active events found.
    </div>
}

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var ev in Model.Events)
    {
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header text-white fw-semibold" style="background: linear-gradient(135deg,#6f42c1,#0d6efd);">
                    <span class="badge bg-light text-dark me-2">@ev.EventCategory</span>
                    <span class="badge @(ev.Status == "Active" ? "bg-success" : "bg-secondary")">@ev.Status</span>
                </div>
                <div class="card-body">
                    <h5 class="card-title">@ev.EventName</h5>
                    <p class="card-text text-muted small">
                        <i class="fa fa-calendar me-1"></i>@ev.EventDate.ToString("dd MMM yyyy")
                    </p>
                    <p class="card-text">@(ev.Description ?? "No description provided.")</p>
                    <p class="text-muted small">
                        <i class="fa fa-chalkboard-teacher me-1"></i>@ev.Sessions.Count session(s)
                    </p>
                </div>
                <div class="card-footer bg-white border-0 d-flex gap-2">
                    <a asp-controller="Home" asp-action="EventDetails" asp-route-id="@ev.EventId"
                       class="btn btn-outline-primary btn-sm flex-fill">
                        <i class="fa fa-eye me-1"></i>View Details
                    </a>
                    <form asp-controller="Participant" asp-action="RegisterEvent" method="post" class="flex-fill">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="eventId" value="@ev.EventId" />
                        <button type="submit" class="btn btn-primary btn-sm w-100">
                            <i class="fa fa-plus me-1"></i>Register
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
