@model List<SpeakerViewModel>
@{
    ViewData["Title"] = "Manage Speakers";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fa fa-microphone me-2"></i>Manage Speakers</h2>
    <a asp-action="CreateSpeaker" class="btn btn-warning">
        <i class="fa fa-plus me-1"></i>Add Speaker
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No speakers found. <a asp-action="CreateSpeaker">Add one</a>.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-3">
        @foreach (var sp in Model)
        {
            <div class="col">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <i class="fa fa-user-tie fa-2x text-warning me-3"></i>
                            <span class="fw-semibold fs-5">@sp.SpeakerName</span>
                        </div>
                        <form asp-action="DeleteSpeaker" method="post"
                              onsubmit="return confirm('Remove @sp.SpeakerName?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@sp.SpeakerId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="fa fa-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
