@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<h2 class="mb-4"><i class="fa fa-tachometer-alt me-2"></i>Dashboard</h2>

<div class="row g-4 mb-5">
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow text-white" style="background:linear-gradient(135deg,#6f42c1,#0d6efd);">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fs-1 fw-bold">@Model.TotalEvents</div>
                    <div>Total Events</div>
                </div>
                <i class="fa fa-calendar-alt fa-3x opacity-50"></i>
            </div>
            <div class="card-footer bg-transparent border-0 text-white-50 small">
                @Model.ActiveEvents Active
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow text-white bg-success">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fs-1 fw-bold">@Model.TotalSessions</div>
                    <div>Sessions</div>
                </div>
                <i class="fa fa-chalkboard-teacher fa-3x opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow text-white bg-warning">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fs-1 fw-bold">@Model.TotalSpeakers</div>
                    <div>Speakers</div>
                </div>
                <i class="fa fa-microphone fa-3x opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow text-white bg-info">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fs-1 fw-bold">@Model.TotalParticipants</div>
                    <div>Participants</div>
                </div>
                <i class="fa fa-users fa-3x opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card border-0 shadow h-100">
            <div class="card-body text-center py-4">
                <i class="fa fa-calendar-alt fa-3x text-primary mb-3"></i>
                <h5>Manage Events</h5>
                <p class="text-muted">Create, edit, or delete virtual events.</p>
                <a asp-action="Events" class="btn btn-primary">Go to Events</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow h-100">
            <div class="card-body text-center py-4">
                <i class="fa fa-chalkboard-teacher fa-3x text-success mb-3"></i>
                <h5>Manage Sessions</h5>
                <p class="text-muted">Add sessions and assign speakers.</p>
                <a asp-action="Sessions" class="btn btn-success">Go to Sessions</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow h-100">
            <div class="card-body text-center py-4">
                <i class="fa fa-microphone fa-3x text-warning mb-3"></i>
                <h5>Manage Speakers</h5>
                <p class="text-muted">Add or remove event speakers.</p>
                <a asp-action="Speakers" class="btn btn-warning">Go to Speakers</a>
            </div>
        </div>
    </div>
</div>
