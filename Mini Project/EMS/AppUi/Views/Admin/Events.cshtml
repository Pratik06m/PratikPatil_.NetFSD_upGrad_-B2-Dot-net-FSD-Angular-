@model List<EventViewModel>
@{
    ViewData["Title"] = "Manage Events";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fa fa-calendar-alt me-2"></i>Manage Events</h2>
    <a asp-action="CreateEvent" class="btn btn-primary">
        <i class="fa fa-plus me-1"></i>Add Event
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No events found. <a asp-action="CreateEvent">Create one</a>.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Event Name</th>
                    <th>Category</th>
                    <th>Date</th>
                    <th>Sessions</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Model)
                {
                    <tr>
                        <td class="fw-semibold">@ev.EventName</td>
                        <td><span class="badge bg-secondary">@ev.EventCategory</span></td>
                        <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <a asp-action="Sessions" asp-route-eventId="@ev.EventId" class="badge bg-info text-decoration-none">
                                @ev.Sessions.Count session(s)
                            </a>
                        </td>
                        <td>
                            <span class="badge @(ev.Status == "Active" ? "bg-success" : "bg-danger")">@ev.Status</span>
                        </td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                <a asp-action="EditEvent" asp-route-id="@ev.EventId" class="btn btn-sm btn-outline-primary">
                                    <i class="fa fa-edit"></i>
                                </a>
                                <form asp-action="ToggleEventStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@ev.EventId" />
                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Toggle Status">
                                        <i class="fa fa-toggle-on"></i>
                                    </button>
                                </form>
                                <a asp-action="CreateSession" asp-route-eventId="@ev.EventId" class="btn btn-sm btn-outline-success" title="Add Session">
                                    <i class="fa fa-plus"></i>
                                </a>
                                <form asp-action="DeleteEvent" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this event and all its sessions?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@ev.EventId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
