@model List<SessionViewModel>
@{
    ViewData["Title"] = "Manage Sessions";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fa fa-chalkboard-teacher me-2"></i>Manage Sessions</h2>
    <a asp-action="CreateSession" class="btn btn-success">
        <i class="fa fa-plus me-1"></i>Add Session
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No sessions found. <a asp-action="CreateSession">Create one</a>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Session Title</th>
                    <th>Event</th>
                    <th>Speaker</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="fw-semibold">@s.SessionTitle</td>
                        <td>
                            <span class="badge bg-primary">@(s.EventName ?? "—")</span>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(s.SpeakerName))
                            {
                                <span class="badge bg-success">@s.SpeakerName</span>
                            }
                            else
                            {
                                <span class="text-muted small">Unassigned</span>
                            }
                        </td>
                        <td class="small">@s.SessionStart.ToString("dd MMM HH:mm")</td>
                        <td class="small">@s.SessionEnd.ToString("dd MMM HH:mm")</td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                <a asp-action="EditSession" asp-route-id="@s.SessionId"
                                   class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="fa fa-edit"></i>
                                </a>
                                <a asp-action="AssignSpeaker" asp-route-sessionId="@s.SessionId"
                                   class="btn btn-sm btn-outline-warning" title="Assign Speaker">
                                    <i class="fa fa-microphone"></i>
                                </a>
                                <form asp-action="DeleteSession" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this session?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@s.SessionId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
